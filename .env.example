# ==============================================================================
# MATHGRADE AI - CẤU HÌNH API KEYS CHO CÁC MÔ HÌNH AI
# ==============================================================================

# 1. Google Gemini API (Lấy key miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 2. Anthropic Claude API (Host: claudecode.pimath.id.vn hoặc official api.anthropic.com)
ANTHROPIC_API_KEY=sk-15c172aa4f3a8c2ef4b7f4c3171806b63166ee99990676e390d3525c
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_BASE_URL=https://claudecode.pimath.id.vn/v1

# ==============================================================================
# CẤU HÌNH ẨN / HIỆN MODEL (MODEL VISIBILITY)
# ==============================================================================
# Danh sách các model Claude được phép hiển thị trên giao diện (cách nhau bởi dấu phẩy).
# Các model hợp lệ theo tài liệu: claude-opus-5, claude-opus-4-8, claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5
# Để trống nếu muốn hiển thị tất cả các model trên.
CLAUDE_VISIBLE_MODELS=claude-opus-5,claude-opus-4-8,claude-opus-4-7,claude-sonnet-4-6,claude-haiku-4-5

# Danh sách các model Claude muốn ẩn (cách nhau bởi dấu phẩy, ví dụ: claude-opus-4-7)
CLAUDE_HIDDEN_MODELS=

# 3. OpenAI / OpenAPI-compatible API (Lấy key tại: https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# 4. OpenRouter API (Qwen 3.8 / Qwen 2.5 VL / QwQ) (Lấy key tại: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 5. Alibaba Cloud Model Studio (Qwen) (Lấy key tại: https://modelstudio.console.alibabacloud.com)
ALIBABACLOUD_API_KEY=
ALIBABACLOUD_MODEL=qwen-plus-character
ALIBABACLOUD_BASE_URL=https://ws-oxwvfx79avt7ebq3.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
