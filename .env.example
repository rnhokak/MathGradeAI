# ==============================================================================
# MATHGRADE AI - CẤU HÌNH API KEYS CHO CÁC MÔ HÌNH AI
# ==============================================================================

# 1. OpenRouter API (Mặc định cho OCR và Chấm bài Qwen) (Lấy key tại: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 2. Google Gemini API (Lấy key miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 3. OpenAI API (Lấy key tại: https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# 4. Alibaba Cloud Model Studio (Qwen) (Lấy key tại: https://modelstudio.console.alibabacloud.com)
ALIBABACLOUD_API_KEY=
ALIBABACLOUD_MODEL=qwen-plus-character
ALIBABACLOUD_BASE_URL=https://ws-oxwvfx79avt7ebq3.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
